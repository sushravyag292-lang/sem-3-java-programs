abstract class Animal {
    abstract void sound();
}

class Dog extends Animal {
    private String name;

    Dog(String name) {
        this.name = name;
    }

    void display() {
        System.out.println("Name: " + name);
    }

    void sound() {
        System.out.println("Dog barks");
    }
}

class OOPConcepts {
    public static void main(String[] args) {
        Dog d = new Dog("Tommy");

        d.display();
        d.sound();
    }
}
